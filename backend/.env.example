# Copy to .env and fill in. The app runs without these (uses an offline stub LLM).

APP_ENV=development
LOG_LEVEL=INFO

# SQLite by default; no external DB needed.
DATABASE_URL=sqlite:///./agenti.db

# GigaChat (Сбер). Base64 of client_id:secret from developers.sber.ru
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat

# Force the offline stub generator even if a key is present (useful for demos/CI).
USE_STUB_LLM=false
